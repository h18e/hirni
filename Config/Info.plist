<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Macht den iCloud-Container als «iCloud Drive → hirni» in Finder und
	     Dateien-App sichtbar. Damit können auch Claude und andere Programme
	     auf die Notizen zugreifen. Nach Änderungen hier muss die Build-Nummer
	     (CURRENT_PROJECT_VERSION) erhöht werden, sonst übernimmt iCloud sie nicht. -->
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.ch.hebera.hirni</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>hirni</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
</dict>
</plist>
